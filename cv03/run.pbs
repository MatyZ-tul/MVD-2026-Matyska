#!/bin/bash
#PBS -N word2vec_training
#PBS -l select=1:ncpus=1:mem=40gb:ngpus=1:scratch_local=10gb:gpu_cap=sm_86
#PBS -l walltime=02:00:00
#PBS -q default@pbs-m1.metacentrum.cz
#PBS -m ae

cd $PBS_O_WORKDIR

# 1. Načtení modulů
module purge
module add metabase/1
module add mambaforge

# 2. Vytvoření prostředí na scratchi
echo "Vytvářím prostředí na scratchi..."
ENV_DIR="$SCRATCHDIR/mvd_2026_env"

# Nastavení dočasných adresářů do scratchu
export TMPDIR=$SCRATCHDIR
export PIP_CACHE_DIR=$SCRATCHDIR/pip_cache

# Vytvoření prostředí s čistým pythonem přes mambu
mamba create --prefix $ENV_DIR python=3.10 -y

# DŮLEŽITÉ: Správná aktivace Mamba/Conda prostředí uvnitř skriptu
eval "$(conda shell.bash hook)"
conda activate $ENV_DIR

# 3. Instalace balíčků pomocí pipu (spolehlivé pro PyTorch s CUDA)
echo "Instaluji balíčky..."
pip install --upgrade pip
pip install numpy
pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121

echo "Prostředí a balíčky úspěšně připraveny."

# 4. Kontrola GPU
python -c "import torch; print('CUDA available:', torch.cuda.is_available(), '| GPU:', torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'None')"

# 5. Spuštění trénování
python train_word2vec.py skipgram

