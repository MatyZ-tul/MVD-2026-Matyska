#PBS -N som_train_wiki
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_mem=32gb:gpu_cap=sm_80:scratch_local=40gb
#PBS -l walltime=02:00:00
#PBS -q default@pbs-m1.metacentrum.cz

# 1. Přesměrování cache Hugging Face a dočasných souborů na rychlý Scratch disk
export HF_HOME="$SCRATCHDIR/hf_cache"
export TMPDIR="$SCRATCHDIR"

# 2. Přechod do pracovní složky cv07
cd /storage/brno2/home/$USER/MVD-2026-Matyska/cv07

# 3. Načtení modulu a aktivace trvalého prostředí z Home
module add mambaforge
conda activate /storage/brno2/home/$USER/envs/mvd_env

echo "=== Trénink SOM sítě na GPU ==="
python som_train.py
